rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Correos que pueden cambiar el inventario.
    // Para agregar al local: ['alizz.mejia03@gmail.com', 'correo-del-local@gmail.com']
    function esAdmin() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email in ['alizz.mejia03@gmail.com'];
    }

    // Revisa que lo que se guarda tenga la forma correcta (validación del lado del servidor).
    function inventarioValido(d) {
      return d.keys().hasOnly(['ing', 'prod', 'cat', 'aviso', 'avisoFecha', 'dia', 'cerradoFecha', 'programados', 'actualizado'])
          && d.ing is map  && d.ing.size()  <= 200
          && d.prod is map && d.prod.size() <= 300
          && d.cat is map  && d.cat.size()  <= 30
          && d.aviso is string && d.aviso.size() <= 140
          && d.avisoFecha is string && d.avisoFecha.size() <= 10
          && d.dia is string && d.dia.size() <= 10
          && d.get('cerradoFecha', '') is string && d.get('cerradoFecha', '').size() <= 10
          && d.get('programados', []) is list && d.get('programados', []).size() <= 40
          && d.actualizado == request.time;
    }

    // Inventario del día: todos lo pueden leer, solo el local lo puede cambiar.
    match /tienda/estado {
      allow read: if true;
      allow create, update: if esAdmin() && inventarioValido(request.resource.data);
      allow delete: if false;
    }

    // Todo lo demás queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
