rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Inventario del día: todos lo pueden leer, solo el local lo puede cambiar.
    match /tienda/estado {
      allow read: if true;
      // Correos que pueden cambiar el inventario. Para agregar al local: ['alizz.mejia03@gmail.com', 'correo-del-local@gmail.com']
      allow write: if request.auth != null
                   && request.auth.token.email in ['alizz.mejia03@gmail.com'];
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
